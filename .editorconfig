# Одинаковые отступы и переводы строк во всех редакторах.
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.go]
indent_style = tab
indent_size = 4

[*.{json,yml,yaml,md}]
indent_style = space
indent_size = 2

[*.md]
# Два пробела в конце строки — перенос в markdown.
trim_trailing_whitespace = false
